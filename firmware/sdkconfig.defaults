# Checked-in project defaults, applied on top of ESP-IDF's own Kconfig
# defaults when sdkconfig is (re)generated - see DEVELOPMENT.md's ESP-IDF
# setup section. The full generated sdkconfig is gitignored (machine/
# build-specific); this file is the source of truth for settings the
# project actually requires against the confirmed reference hardware (see
# docs/architecture/hardware.md).

# Real flash size confirmed via first boot on the Tab5 K145 reference
# unit - the ESP-IDF default (2MB) leaves 14MB of real flash unaddressed,
# which matters once OTA/partition planning (ADR-0012) needs the real
# budget. CONFIG_ESPTOOLPY_FLASHSIZE is a computed value from this choice,
# not directly settable.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 32MB PSRAM confirmed on the reference hardware (see hardware.md's
# Application processor section) - disabled by ESP-IDF's default config,
# which left it detected but unusable (0 free bytes reported) on first
# boot. ESP32-P4 has no Quad/Octal choice like other chips - its only
# SPIRAM_MODE option is HEX ("16-Line-Mode PSRAM"), a P4-specific memory
# controller mode, so it doesn't need setting explicitly here.
CONFIG_SPIRAM=y

# ESP32-P4's PSRAM Kconfig only offers two speeds: 20MHz (the default,
# gated behind nothing) or 200MHz (gated behind IDF_EXPERIMENTAL_FEATURES
# - no 100MHz option exists despite what the Kconfig help text implies).
# 20MHz causes a continuous DMA underrun in the display's PSRAM-backed
# framebuffer path (see hardware.md#display-and-touch). 200MHz is
# explicitly marked experimental by ESP-IDF itself, not just an arbitrary
# faster number - flag if this destabilizes anything else later.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_200M=y

# A flash write/erase disables the L2 cache for its duration on the
# ESP32-P4 (spi_flash_disable_interrupts_caches_and_other_cpu(), IDF's
# spi_flash/cache_utils.c) - the same cache the PSRAM-backed display
# framebuffer is read through, which was starving the DSI DMA
# mid-scanout and producing a visible glitch (see
# docs/decisions/ADR-0021-xip-from-psram.md). Moving .text/.rodata into
# PSRAM removes code execution's dependency on that cache, so ESP-IDF
# skips disabling it for a flash operation at all
# (docs/en/api-guides/external-ram.rst's XiP-from-PSRAM section) -
# trading increased steady-state PSRAM bus load (all code fetches now
# compete with DSI scanout, not just during flash writes) for removing
# the disable window entirely. Confirmed on hardware: the glitch is
# gone.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# EventBus (src/core/event_bus.h) uses typeid()/std::type_index for its
# per-event-type subscriber dispatch - a real, load-bearing design
# choice, not something to work around. ESP-IDF disables C++ RTTI by
# default (typically saves tens of kB of flash) since most firmware
# doesn't need it; this project does.
CONFIG_COMPILER_CXX_RTTI=y

# Custom OTA A/B partition table (firmware/partitions.csv) - 4MB ota_0/
# ota_1 app slots (real headroom past current usage), plus nvs_keys,
# coredump, and storage (FAT + wear_levelling) partitions reserved for
# not-yet-built M2 services. See
# docs/decisions/ADR-0017-partition-table.md for the full sizing
# rationale.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Wi-Fi runs through the ESP32-C6 co-processor over SDIO (via esp_hosted/
# esp_wifi_remote - see docs/architecture/hardware.md#wireless). Confirmed
# on real hardware:
# - ESP-Hosted's SDIO transport needs a ~48KB contiguous block of internal
#   DMA-capable RAM that isn't available that early in boot - redirecting
#   those buffers into PSRAM (the same GDMA-through-PSRAM-cache path the
#   display already uses) fixes it.
# - ESP-Hosted's default SDIO pin config assumes Espressif's P4 eval
#   board, not this hardware - the real Tab5 pins are set explicitly
#   below (see hardware.md#wireless for how these were found).
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=12
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=13
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=11
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=10
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=9
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=8
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15

# esp_http_server's default max request header size (512 bytes) is too
# small for real mobile browsers - a modern browser's Sec-Ch-Ua/Accept-*/
# Origin headers alone can exceed 512 bytes, causing 431 Request Header
# Fields Too Large. This is a RAM buffer, not flash - no cost against the
# tight flash budget above.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=4096

# FATFS defaults to 8.3 short filenames only - too restrictive for the
# `storage` partition's real module-ID/key-based paths (e.g.
# "home_assistant" exceeds 8 characters). Long filename support costs
# heap, not flash, which is why it's not part of the flash-headroom
# tradeoffs above.
CONFIG_FATFS_LFN_HEAP=y

# Crash/reboot diagnostics (ADR-0013) - capture a core dump to the
# `coredump` partition (already reserved, see ADR-0017) on panic. ELF
# format and CRC32 checksum are already the defaults once this is
# enabled - not set explicitly here. Two things confirmed already
# handled without further config, not left to chance:
# - espcoredump's Kconfig warns core dumps to flash aren't available
#   when task stacks are in PSRAM, but ESP_COREDUMP_USE_STACK_SIZE
#   already defaults to y whenever this is combined with
#   FREERTOS_TASK_CREATE_ALLOW_EXT_MEM, auto-allocating the dedicated
#   internal-DRAM stack the coredump handler needs in that case.
# - ADR-0013's "must not halt-and-wait-for-debugger" requirement is
#   already this IDF version's own default panic behavior
#   (ESP_SYSTEM_PANIC_PRINT_REBOOT) - nothing here overrides it.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# mbedtls defaults to hardware-accelerated SHA (GDMA + the SHA
# peripheral) - its own Kconfig help text already warns "faster than
# software in some situations but slower in others, you should
# benchmark." AdminAuthService's PBKDF2-SHA256 password hashing
# (100,000 iterations, ~200,000 individual SHA256 block operations) is
# the "slower" case: a fixed per-call DMA setup/teardown cost, paid on
# every one of those operations, took a single login call past 30
# seconds on real hardware - long enough to trip the task watchdog.
# Software SHA256 has no such per-call overhead.
CONFIG_MBEDTLS_HARDWARE_SHA=n

# app_main() never returns - every Core service (Storage, AdminAuthService,
# FirmwareHttpServer, EventBus, Clock, dashboard/widget objects, and more
# as the app grows) is a direct stack-local in its body, not heap-allocated,
# for the whole program's lifetime. ESP-IDF's default main task stack
# (3584 bytes) is sized for a minimal app_main, not one holding this many
# service objects directly, and causes a stack-protection-fault panic in
# task "main". Raised generously, not just past the current requirement,
# since more Core services land here over time and PSRAM/RAM headroom
# makes a generous static stack cheap (see hardware.md's Application
# processor section).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Clock (src/core/clock.h) is built on FreeRTOS software timers (see
# platform/firmware/timer.cpp) - its periodic tick runs on FreeRTOS's
# single shared "Tmr Svc" task, not app_main's. LowBatteryMonitor
# subscribes to that tick as a plain (non-UI) EventBus subscriber (see
# core/event_bus.cpp's PublishImpl), so its callback - which reads the
# INA226 over I2C via Ina226BatteryReader::ReadPercent() - runs
# synchronously on "Tmr Svc" too, not marshaled onto the LVGL task the
# way UI subscribers are. ESP-IDF's default timer-service stack (2048
# bytes) isn't sized for a real I2C transaction's mutex/driver call
# depth on top of it, and causes a stack-protection-fault panic in task
# "Tmr Svc". Raised generously for the same reason as the main task
# stack above - more Core services may end up in this same call path
# over time.
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=8192

# OTA app-rollback (docs/architecture/web-ui.md#ota) - the bootloader
# boots a freshly-updated image in a "pending verify" state; if
# esp_ota_mark_app_valid_cancel_rollback() (firmware/main/homedeck.cpp,
# called once real boot success is confirmed) is never reached, the
# device is meant to revert to the previous OTA slot on the next boot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# StatusBar (src/ui/status_bar.h) uses Montserrat 24, not LVGL's default
# Montserrat 14, which is too small to read at a glance on the Tab5's
# physical screen. On this panel's ~294 PPI (from its 5" 720x1280 spec -
# see hardware.md's Display and touch section), Montserrat 24 measures
# ~2.1mm tall, the closest match among LVGL's available discrete sizes to
# Android's typical status bar text (~2.2mm, approximating AOSP's ~14sp
# at a representative ~440 PPI phone density). Must be enabled on both
# targets identically (see simulator/lv_conf.h) since each target
# compiles its own LVGL font table; a font enabled on only one side would
# build fine there and fail to link on the other.
CONFIG_LV_FONT_MONTSERRAT_24=y

# ClockWidget (src/ui/clock_widget.h) uses Montserrat 48 for its large
# time display - deliberately bigger than the status bar's own clock,
# the same "compact status-bar clock plus an optional larger clock
# widget" pairing docs/architecture/dashboard.md describes. Must be
# enabled on both targets identically, same reasoning as Montserrat 24
# above.
CONFIG_LV_FONT_MONTSERRAT_48=y
