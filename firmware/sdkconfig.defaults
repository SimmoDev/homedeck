# Checked-in project defaults, applied on top of ESP-IDF's own Kconfig
# defaults when sdkconfig is (re)generated - see DEVELOPMENT.md's ESP-IDF
# setup section. The full generated sdkconfig is gitignored (machine/
# build-specific); this file is the source of truth for settings the
# project actually requires against the confirmed reference hardware (see
# docs/architecture/hardware.md).

# Real flash size confirmed via first boot on the Tab5 K145 reference
# unit - the ESP-IDF default (2MB) leaves 14MB of real flash unaddressed,
# which matters once OTA/partition planning (ADR-0012) needs the real
# budget. CONFIG_ESPTOOLPY_FLASHSIZE is a computed value from this choice,
# not directly settable.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 32MB PSRAM confirmed on the reference hardware (see hardware.md's
# Application processor section) - disabled by ESP-IDF's default config,
# which left it detected but unusable (0 free bytes reported) on first
# boot. ESP32-P4 has no Quad/Octal choice like other chips - its only
# SPIRAM_MODE option is HEX ("16-Line-Mode PSRAM"), a P4-specific memory
# controller mode, so it doesn't need setting explicitly here.
CONFIG_SPIRAM=y

# ESP32-P4's PSRAM Kconfig only offers two speeds: 20MHz (the default,
# gated behind nothing) or 200MHz (gated behind IDF_EXPERIMENTAL_FEATURES
# - no 100MHz option exists despite what the Kconfig help text implies).
# 20MHz caused a continuous DMA underrun feeding the display's PSRAM-
# backed framebuffer - confirmed fixed on hardware by raising to 200MHz
# (see hardware.md#display-and-touch). This is explicitly marked
# experimental by ESP-IDF itself, not just an arbitrary faster number -
# flag if this destabilizes anything else later, not just the underrun.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM_SPEED_200M=y

# EventBus (src/core/event_bus.h) uses typeid()/std::type_index for its
# per-event-type subscriber dispatch - a real, load-bearing design
# choice, not something to work around. ESP-IDF disables C++ RTTI by
# default (typically saves tens of kB of flash) since most firmware
# doesn't need it; this project does.
CONFIG_COMPILER_CXX_RTTI=y

# ESP-Hosted's SDIO transport crashed on first boot -
# "assert failed: sdio_mempool_create sdio_drv.c:255 (buf_mp_g)" - a
# ~48KB single contiguous allocation (31 buffers x 1536 bytes) requesting
# MALLOC_CAP_DMA|MALLOC_CAP_INTERNAL, which apparently isn't available as
# one contiguous block in the P4's internal SRAM this early in boot, even
# though the internal heap's total free size is far larger than 48KB
# (fragmentation, not exhaustion). ESP-Hosted's own Kconfig explicitly
# names this chip as a case where this should be redirected to PSRAM
# instead - "GDMA can reach PSRAM through cache (e.g. ESP32-P4...)" -
# which this project's own PSRAM already does at 200MHz for the display
# (see the SPIRAM_SPEED_200M note above). Confirmed fixed on hardware -
# the mempool assert no longer happens with this set.
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y

# ESP-Hosted defaults to SDIO "Slot 1" with Espressif eval-board pins,
# which don't match the Tab5's real wiring - SDIO just times out talking
# to nothing ("sdmmc_init_ocr: send_op_cond returned 0x107"). The real C6
# SDIO2 pins are CLK=12, CMD=13, D0=11, D1=10, D2=9, D3=8, reset=15 -
# Slot 1 (GPIO-matrix) with these pins overridden, not Slot 0 (fixed
# IOMUX pins, out of range for these values anyway). Caution:
# m5stack_tab5.c's `GPIO_SDMMC_*` constants (43/44/39/40/41/42) look
# similar but are the microSD card slot's separate SDMMC host instance,
# not the C6. Confirmed fixed on hardware: SDIO links up, the C6
# identifies itself, and a real Wi-Fi connection gets a real IP. See
# hardware.md#wireless.
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=12
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=13
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=11
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=10
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=9
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=8
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=15

# ESP-IDF's default single-app partition table (1024K) left only 1%
# free once the real dashboard (EventBus/Clock/DashboardScreen, the
# BSP, LVGL, RTTI) was actually linked in - a real near-term blocker,
# not cosmetic. This is the built-in larger single-app table (1500K),
# a pragmatic unblock, not the real OTA A/B partition table - that's
# already documented as explicit M2 scope (see ADR-0012 and
# docs/roadmap.md's OTA item), not something to improvise here as a
# side effect of a flash-space warning. Expect to revisit this again -
# 1500K is headroom, not a permanent ceiling.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
